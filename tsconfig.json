{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["components", "lib", "middleware", "pages", "receipt", "server", "void.config.ts", "vite.config.ts"],
  "exclude": ["**/*.test.ts"]
}
